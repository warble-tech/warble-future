{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "warble-future",
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "warble-future-leads",
      "database_id": "5e40e8e2-d20a-4b3f-b408-0f07f47d53d1"
    }
  ],
  "vars": {
    "NOTIFY_EMAIL": "contact@warblecloud.com"
  }
}
